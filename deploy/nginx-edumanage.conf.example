# Nginx reverse proxy for EduManage SaaS.
# Copy to /etc/nginx/sites-available/edumanage and enable with a symlink.
# Replace app.example.com, paths and certificate names.

server {
    listen 80;
    server_name app.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.example.com;

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Must be >= DATA_UPLOAD_MAX_MEMORY_SIZE (26 MB) in settings.
    client_max_body_size 26M;

    location /static/ {
        alias /srv/edumanage/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # NEVER serve uploads directly. Every file is read through an
    # authenticated Django view that checks tenant, role and batch.
    location /media/ {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
