# Copy this file to .env and adjust the values for your machine.
# NEVER commit .env. Keep production secrets in the host's secret manager.

# --- Common ---
DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Paths (optional overrides) ---
# STATIC_ROOT=/srv/edumanage/staticfiles
# MEDIA_ROOT=/var/lib/edumanage/media
# LOG_DIR=/var/log/edumanage

# --- Database ---
# Development uses SQLite by default. Leave DATABASE_URL empty for SQLite.
DATABASE_URL=
# MySQL example (production):
# DATABASE_URL=mysql://edumanage:strong-password@127.0.0.1:3306/edumanage
# MySQL TLS CA certificate (optional, recommended for remote databases):
# DATABASE_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Email ---
# Development forces the console backend; production defaults to SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=no-reply@example.com
ADMIN_EMAIL=ops@example.com

# --- Razorpay (sandbox by default; NEVER commit live keys) ---
# Use test keys (rzp_test_...) while developing.
RAZORPAY_KEY_ID= rzp_test_U1uuAl2bxRWXuG
RAZORPAY_KEY_SECRET=363uHfNn6BXECZefGy9SVlWK
# Use the distinct webhook signing secret from the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SANDBOX=True
RAZORPAY_CURRENCY=INR

# --- Production HTTPS / cookies ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# TRUST_X_FORWARDED_PROTO=True  # set False if not behind a trusted TLS proxy
# SESSION_COOKIE_DOMAIN=.example.com
# CSRF_COOKIE_DOMAIN=.example.com

# --- Database backups ---
# BACKUP_DIR=/var/backups/edumanage
